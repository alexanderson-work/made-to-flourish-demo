---
// Section / Contact Band.
import Floral from '../components/Floral.astro';
import { contact } from '../data/site';
const tel = '+1' + contact.phone.replace(/\D/g, '');
---
<section class="mtf-section mtf-contact" aria-labelledby="contact-title">
  <Floral name="daffodils" width={305} />
  <div class="mtf-container">
    <h2 id="contact-title" class="mtf-h1" data-reveal="words">Questions?</h2>
    <p class="mtf-body-display" data-reveal="block">Contact {contact.name} at <a href={`mailto:${contact.email}`}>{contact.email}</a> or <a href={`tel:${tel}`}>{contact.phone}</a>.</p>
  </div>
</section>
