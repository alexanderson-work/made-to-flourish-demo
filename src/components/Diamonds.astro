---
// Diamond Marker (Figma: Labels & Forms → Diamond Marker), 1–3 diamonds.
interface Props { count?: 1 | 2 | 3 | number }
const { count = 1 } = Astro.props;
---
<div class="mtf-diamonds" aria-hidden="true">{Array.from({ length: count }, (_, i) => <span class="mtf-appear mtf-appear--pop" style={i ? `--delay: ${(i * 0.2).toFixed(1)}s` : undefined} />)}</div>
