---
// Navigation (Figma: Chrome & Media → Navigation). Fixed; on phones only the wordmark and RSVP show.
// transition:persist keeps this same header on screen when the page changes (Astro's client router), so it never
// redraws, jumps or clips; Base.astro marks the current page in it after each change.
import Button from './Button.astro';
import { nav } from '../data/site';
// The wordmark is drawn inline, so it's there on the first frame instead of loading as a separate image.
import logo from '../assets/logo-wordmark-white.svg?raw';
---
<header class="mtf-header" transition:persist="site-header">
  <div class="mtf-header__inner">
    <a class="mtf-logo" href="/" aria-label="Made to Flourish, home"><Fragment set:html={logo.replace('<svg ', '<svg aria-hidden="true" focusable="false" ')} /></a>
    <nav aria-label="Main">
      {nav.map((l) => <a class="mtf-nav-link" href={l.href}>{l.label}</a>)}
      <Button href="/register" aria-current={Astro.url.pathname.startsWith('/register') ? 'page' : undefined}>RSVP</Button>
    </nav>
  </div>
</header>
