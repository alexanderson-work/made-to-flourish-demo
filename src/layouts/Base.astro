---
// Page shell: head, skip link, header, main, footer, and the small amount of behavior the system needs.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { event } from '../data/site';
interface Props { title?: string; description?: string }
const { title = event.name, description = event.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("mtf-motion");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1D5552" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/tiempos-text-regular-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gt-pressura-light.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="mtf-visually-hidden mtf-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      // Motion (design system → Motion). Split word reveals into words, then play entrances once, in view.
      const splitWords = (el: Element) => {
        let i = 0;
        const walk = (node: Node) => [...node.childNodes].forEach((child) => {
          if (child.nodeType === Node.TEXT_NODE) {
            const frag = document.createDocumentFragment();
            (child.textContent ?? '').split(/(\s+)/).forEach((part) => {
              if (!part) return;
              if (/^\s+$/.test(part)) return frag.append(part);
              const w = document.createElement('span');
              w.className = 'mtf-word'; w.style.setProperty('--i', String(i++)); w.textContent = part; frag.append(w);
            });
            (child as ChildNode).replaceWith(frag);
          } else if (child.nodeType === Node.ELEMENT_NODE && (child as Element).tagName !== 'BR') walk(child);
        });
        walk(el);
        el.classList.add('mtf-split');
      };
      document.querySelectorAll('[data-reveal="words"]').forEach(splitWords);
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }),
        { threshold: 0 },
      );
      document.querySelectorAll('.mtf-appear, [data-reveal]').forEach((el) => io.observe(el));

      // Parallax: florals move an extra 10% of the scroll, centered on their section.
      const florals = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
      if (florals.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const k = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--mtf-motion-parallax')) || 0.1;
        let queued = false;
        const update = () => {
          queued = false;
          florals.forEach((el) => {
            const r = (el.closest('section') ?? el.parentElement!).getBoundingClientRect();
            el.style.translate = `0 ${((r.top + r.height / 2 - innerHeight / 2) * k).toFixed(1)}px`;
          });
        };
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update);
        update();
      }

      // Speaker modals: open from "Learn More", close on the X, Escape (native) or a backdrop click.
      document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
        b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement | null)?.showModal()),
      );
      document.querySelectorAll('dialog').forEach((d) => {
        d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
        d.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => d.close()));
      });

      // Carousels (photo strips, stories): arrows scroll one item; each arrow hides at its end.
      document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
        const track = c.querySelector<HTMLElement>('[data-track]')!;
        const prev = c.querySelector<HTMLButtonElement>('[data-prev]');
        const next = c.querySelector<HTMLButtonElement>('[data-next]');
        const step = () => (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? track.clientWidth;
        const update = () => {
          const max = track.scrollWidth - track.clientWidth - 2;
          if (prev) prev.hidden = track.scrollLeft <= 2;
          if (next) next.hidden = track.scrollLeft >= max;
        };
        prev?.addEventListener('click', () => track.scrollBy({ left: -step() }));
        next?.addEventListener('click', () => track.scrollBy({ left: step() }));
        track.addEventListener('scroll', update, { passive: true });
        addEventListener('resize', update);
        update();
      });

      // RSVP (front end only in this test): required fields, a loading state, then the success state.
      document.querySelectorAll<HTMLFormElement>('form[data-rsvp]').forEach((form) => {
        const status = form.querySelector<HTMLElement>('.mtf-form__status')!;
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.querySelectorAll('.mtf-field-error').forEach((n) => n.remove());
          let first: HTMLElement | null = null;
          form.querySelectorAll<HTMLInputElement>('input, textarea, select').forEach((f) => {
            const ok = f.checkValidity();
            f.setAttribute('aria-invalid', String(!ok));
            if (!ok) {
              const msg = document.createElement('span');
              msg.className = 'mtf-field-error';
              msg.id = `${f.name}-error`;
              msg.textContent = f.validity.valueMissing ? 'This field is required.' : 'Please check this field.';
              f.setAttribute('aria-describedby', msg.id);
              f.after(msg);
              first ??= f;
            } else f.removeAttribute('aria-describedby');
          });
          if (first) { (first as HTMLElement).focus(); return; }
          submit.setAttribute('aria-busy', 'true');
          submit.disabled = true;
          status.textContent = 'Sending…';
          setTimeout(() => {
            submit.removeAttribute('aria-busy');
            submit.textContent = 'Thank you';
            status.textContent = 'Thank you. This test form does not send anything.';
          }, 900);
        });
      });
    </script>
  </body>
</html>
