---
// Page shell: head, skip link, header, main, footer, and the small amount of behavior the system needs.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { event } from '../data/site';
interface Props { title?: string; description?: string }
const { title = event.name, description = event.description } = Astro.props;
// Link previews (the 2026 Framer site's social image and favicon)
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/social.png', Astro.site);
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Motion is on once JavaScript runs. The router replaces <html>'s attributes on each page change, so add it back.
      (() => { const on = () => document.documentElement.classList.add("mtf-motion"); on(); document.addEventListener("astro:after-swap", on); })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1D5552" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Experience Made to Flourish" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preload" href="/fonts/tiempos-text-regular-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gt-pressura-light.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <a class="mtf-visually-hidden mtf-skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      // Page behavior. Pages change through Astro's client router: the header stays on screen (transition:persist) and
      // only the page underneath is swapped, so everything below is set up per page and torn down before the next one.
      const splitWords = (el: Element) => {
        let i = 0;
        const walk = (node: Node) => [...node.childNodes].forEach((child) => {
          if (child.nodeType === Node.TEXT_NODE) {
            const frag = document.createDocumentFragment();
            (child.textContent ?? '').split(/(\s+)/).forEach((part) => {
              if (!part) return;
              if (/^\s+$/.test(part)) return frag.append(part);
              const w = document.createElement('span');
              w.className = 'mtf-word'; w.style.setProperty('--i', String(i++)); w.textContent = part; frag.append(w);
            });
            (child as ChildNode).replaceWith(frag);
          } else if (child.nodeType === Node.ELEMENT_NODE && (child as Element).tagName !== 'BR') walk(child);
        });
        walk(el);
        el.classList.add('mtf-split');
      };

      const init = () => {
        const ac = new AbortController();
        const on = { signal: ac.signal };
        let io: IntersectionObserver | undefined;

        // The header persists between pages, so mark the current page in it here.
        document.querySelectorAll<HTMLAnchorElement>('.mtf-header a[href]').forEach((a) => {
          const here = new URL(a.href).pathname === location.pathname && !new URL(a.href).hash;
          if (here) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
        });

        // Motion (design system → Motion). Split word reveals into words, then, once the brand fonts are in (at most
        // 1 s) and the page has painted, play entrances once, in view; .mtf-ready also releases the hero.
        document.querySelectorAll('[data-reveal="words"]:not(.mtf-split)').forEach(splitWords);
        Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1000))]).then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
          if (ac.signal.aborted) return;
          io = new IntersectionObserver(
            (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io!.unobserve(e.target); } }),
            { threshold: 0 },
          );
          document.querySelectorAll('.mtf-appear, [data-reveal]').forEach((el) => io!.observe(el));
          document.documentElement.classList.add('mtf-ready');
        })));

        // Parallax: florals move an extra 10% of the scroll, centered on their section.
        const florals = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
        if (florals.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const k = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--mtf-motion-parallax')) || 0.1;
          let queued = false;
          const update = () => {
            queued = false;
            florals.forEach((el) => {
              const r = (el.closest('section') ?? el.parentElement!).getBoundingClientRect();
              el.style.translate = `0 ${((r.top + r.height / 2 - innerHeight / 2) * k).toFixed(1)}px`;
            });
          };
          addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true, ...on });
          addEventListener('resize', update, on);
          update();
        }

        // Speaker modals: open from "Learn More", close on the X, Escape (native) or a backdrop click.
        document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
          b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement | null)?.showModal()),
        );
        document.querySelectorAll('dialog').forEach((d) => {
          d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
          d.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => d.close()));
        });

        // Carousels (photo strips, stories): arrows scroll one item; each arrow hides at its end.
        document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
          const track = c.querySelector<HTMLElement>('[data-track]')!;
          const prev = c.querySelector<HTMLButtonElement>('[data-prev]');
          const next = c.querySelector<HTMLButtonElement>('[data-next]');
          const step = () => (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? track.clientWidth;
          const update = () => {
            const max = track.scrollWidth - track.clientWidth - 2;
            if (prev) prev.hidden = track.scrollLeft <= 2;
            if (next) next.hidden = track.scrollLeft >= max;
          };
          prev?.addEventListener('click', () => track.scrollBy({ left: -step() }));
          next?.addEventListener('click', () => track.scrollBy({ left: step() }));
          track.addEventListener('scroll', update, { passive: true });
          addEventListener('resize', update, on);
          update();
        });

        // RSVP (front end only in this demo): required fields, a loading state, then the success state.
        document.querySelectorAll<HTMLFormElement>('form[data-rsvp]').forEach((form) => {
          const status = form.querySelector<HTMLElement>('.mtf-form__status')!;
          const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            form.querySelectorAll('.mtf-field-error').forEach((n) => n.remove());
            let first: HTMLElement | null = null;
            form.querySelectorAll<HTMLInputElement>('input, textarea, select').forEach((f) => {
              const ok = f.checkValidity();
              f.setAttribute('aria-invalid', String(!ok));
              if (!ok) {
                const msg = document.createElement('span');
                msg.className = 'mtf-field-error';
                msg.id = `${f.name}-error`;
                msg.textContent = f.validity.valueMissing ? 'This field is required.' : 'Please check this field.';
                f.setAttribute('aria-describedby', msg.id);
                f.after(msg);
                first ??= f;
              } else f.removeAttribute('aria-describedby');
            });
            if (first) { (first as HTMLElement).focus(); return; }
            submit.setAttribute('aria-busy', 'true');
            submit.disabled = true;
            status.textContent = 'Sending…';
            setTimeout(() => {
              submit.removeAttribute('aria-busy');
              submit.textContent = 'Thank you';
              status.textContent = 'Thank you. This demo form does not send anything.';
            }, 900);
          });
        });

        return () => { ac.abort(); io?.disconnect(); };
      };

      let cleanup = init();

      // Page change: the page content fades out while the next page loads, then the new content fades in under the
      // header. This replaces the browser's view-transition cross-fade, which animates a picture of each page: in that
      // picture the header's backdrop blur is missing, so the hero showed sharp through the nav until the blur popped
      // back in. Here the header stays the live element the whole time.
      const pageParts = () => [...document.querySelectorAll<HTMLElement>('main, .mtf-footer')];
      const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.addEventListener('astro:before-preparation', (e) => {
        const load = e.loader;
        e.loader = async () => {
          const out = reduced() ? [] : pageParts().map((el) => el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, easing: 'ease-out', fill: 'forwards' }));
          e.signal.addEventListener('abort', () => out.forEach((a) => a.cancel()));
          try { await Promise.all([load(), ...out.map((a) => a.finished.catch(() => {}))]); }
          catch (err) { out.forEach((a) => a.cancel()); throw err; }
        };
      });
      document.addEventListener('astro:before-swap', (e) => {
        cleanup();
        if (e.viewTransition) { e.viewTransition.ready.catch(() => {}); e.viewTransition.skipTransition(); }
        // Arriving at a section from another page (e.g. RSVP → /#speakers): jump there while the page fades in, instead
        // of smooth-scrolling down from the top. Smooth scrolling comes back once the new page is in place.
        const swap = e.swap;
        e.swap = () => { swap(); document.documentElement.style.scrollBehavior = 'auto'; };
      });
      document.addEventListener('astro:after-swap', () => {
        if (!reduced()) pageParts().forEach((el) => el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 400, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }));
        cleanup = init();
        requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.style.removeProperty('scroll-behavior')));
      });
    </script>
  </body>
</html>
